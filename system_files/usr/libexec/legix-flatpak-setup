#!/bin/bash
# Legix: trim the Flatpaks Bazzite preinstalls to what Legix ships, once per
# list version. Removes apps Legix doesn't use and installs Zen (the default
# browser) and Heroic (Epic, GOG and Amazon games). Re-runs only when
# LEGIX_FLATPAK_VERSION changes. If Flathub is unreachable, it exits non-zero
# without stamping, so the next boot retries.
set -uo pipefail
LEGIX_FLATPAK_VERSION=2
stamp=/var/lib/legix/flatpak-setup-version
[[ "$(cat "$stamp" 2>/dev/null)" == "$LEGIX_FLATPAK_VERSION" ]] && exit 0

REMOVE=(
  org.mozilla.firefox            # replaced by Zen
  page.tesk.Refine               # GNOME tweaks; no GNOME
  com.mattjakeman.ExtensionManager
  org.gnome.Contacts org.gnome.Calendar org.gnome.Weather org.gnome.clocks
  org.gnome.Characters org.gnome.Logs org.gnome.Firmware org.gnome.baobab
  io.github.flattool.Warehouse com.ranfdev.DistroShelf
)
INSTALL=(
  app.zen_browser.zen
  com.heroicgameslauncher.hgl   # Epic, GOG and Amazon games
)

installed="$(flatpak list --system --app --columns=application)"
for app in "${REMOVE[@]}"; do
  grep -qx "$app" <<< "$installed" && flatpak uninstall --system --noninteractive "$app"
done
ok=true
for app in "${INSTALL[@]}"; do
  grep -qx "$app" <<< "$installed" && continue
  flatpak install --system --noninteractive flathub "$app" || ok=false
done
flatpak uninstall --system --noninteractive --unused || :
$ok || exit 1
mkdir -p "$(dirname "$stamp")"
echo "$LEGIX_FLATPAK_VERSION" > "$stamp"

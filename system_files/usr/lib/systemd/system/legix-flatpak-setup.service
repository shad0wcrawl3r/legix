[Unit]
Description=Legix: trim preinstalled Flatpaks and install Zen and Heroic (once per list version)
Documentation=https://github.com/shad0wcrawl3r/legix
Wants=network-online.target
After=network-online.target bazzite-flatpak-manager.service
ConditionPathExists=!/etc/legix/no-flatpak-setup

[Service]
Type=oneshot
ExecStart=/usr/libexec/legix-flatpak-setup
Restart=no

[Install]
WantedBy=multi-user.target
